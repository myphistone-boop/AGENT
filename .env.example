# ========================================
# CONFIGURATION À REMPLIR
# ========================================
# Copiez ce fichier en .env et remplissez vos valeurs

# ===== EMAIL CONFIGURATION (OBLIGATOIRE) =====
# Clé API SendGrid : https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=votre-email@votreentreprise.com
FROM_NAME=Votre Nom

# ===== IA CONFIGURATION (OPTIONNEL - seulement pour clients sans site) =====
# Clé API Anthropic : https://console.anthropic.com/settings/keys
# Si vous ne voulez pas utiliser l'IA, laissez vide ou commentez
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
USE_AI_FOR_NO_SITE=true

# ===== PARAMÈTRES DE PROSPECTION =====
MAX_PROSPECTS_PER_DAY=50
DELAY_BETWEEN_EMAILS=2

# ===== PROXY CONFIGURATION (si vous êtes derrière un proxy d'entreprise) =====
# Laissez vide si pas de proxy
HTTP_PROXY=
HTTPS_PROXY=
# Exemple : HTTP_PROXY=http://proxy.entreprise.com:8080

# ===== SSL CONFIGURATION (si problèmes de certificats) =====
# Mettre à false seulement si vous avez des erreurs SSL
VERIFY_SSL=true

# ===== MODE DEBUG =====
DEBUG_MODE=false
LOG_LEVEL=INFO
